# Quartus build databases and caches
MiniProject/db/
MiniProject/incremental_db/
MiniProject/greybox_tmp/
MiniProject/.qsys_edit/

# Compilation output, except the programmed bitstream, the pin report and the
# Programmer chain description, which are kept for reference.
MiniProject/output_files/*
!MiniProject/output_files/miniProject.sof
!MiniProject/output_files/miniProject.pin
!MiniProject/output_files/miniProject.cdf

# Tool and editor backups
*.bak
*.qws
